// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  email       String   @unique
  password    String
  name        String
  phone       String?
  role        String // "customer" | "shopkeeper" | "delivery_agent" | "admin" | "SHOPKEEPER" | "DELIVERY_PARTNER"
  firebaseUid String?
  supabaseUid String?
  fcmToken    String?  @default("")
  addresses   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  shop            Shop?
  deliveryPartner DeliveryPartner?
  orders          Order[]

  @@map("users")
}

model Shop {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @db.ObjectId
  name        String
  description String?
  tagline     String?
  address     String
  city        String?  @default("Ara")
  area        String?
  pincode     String?  @default("802301")
  phone       String?
  lat         Float    @default(25.556)
  lng         Float    @default(84.660)
  imageUrl    String?
  logo        String?
  banner      String?
  categories  String[] @default([])
  rating      Float    @default(4.5)
  numRatings  Int      @default(0)
  isActive    Boolean  @default(true)
  isOpen      Boolean? @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]

  @@map("shops")
}

model Product {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  shopId         String   @db.ObjectId
  storeName      String?
  createdBy      String?  @db.ObjectId
  name           String
  category       String
  description    String?
  price          Float
  originalPrice  Float?
  discount       Float?   @default(0)
  imageUrl       String?
  rating         Float?   @default(4.5)
  reviews        Json?
  unit           String?  @default("1 item")
  stock          Int      @default(0)
  isAvailable    Boolean  @default(true)
  isTrending     Boolean? @default(false)
  isDealOfTheDay Boolean? @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  @@map("products")
}

model InventoryLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  productId    String   @db.ObjectId
  changeAmount Int // positive = added, negative = reduced
  reason       String
  stockBefore  Int
  stockAfter   Int
  createdAt    DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory_logs")
}

model DeliveryPartner {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  vehicleType     String   @default("MOTORCYCLE") // "BICYCLE", "MOTORCYCLE", "CAR", "AUTO"
  isAvailable     Boolean  @default(false)
  rating          Float    @default(5.0)
  totalDeliveries Int      @default(0)
  totalEarnings   Float    @default(0.0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("delivery_partners")
}

model Order {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId        String?   @db.ObjectId
  shopId            String    @db.ObjectId
  deliveryPartnerId String?   @db.ObjectId
  status            String    @default("Pending") // "Pending", "Accepted", "PickedUp", "InTransit", "Delivered", "Cancelled"
  totalAmount       Float
  subtotal          Float     @default(0.0)
  deliveryFee       Float     @default(40.0)
  tax               Float     @default(0.0)
  customerName      String
  customerPhone     String
  deliveryAddress   String
  notes             String?
  paymentMethod     String    @default("COD")
  paymentResult     Json?
  isPaid            Boolean   @default(false)
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  customer        User?            @relation(fields: [customerId], references: [id])
  shop            Shop             @relation(fields: [shopId], references: [id])
  deliveryPartner DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId      String  @db.ObjectId
  productId    String  @db.ObjectId
  productName  String?
  productImage String?
  quantity     Int
  unitPrice    Float

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}
