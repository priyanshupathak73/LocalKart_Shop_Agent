# Server
PORT=5000
NODE_ENV=development

# PostgreSQL via Prisma — update credentials before running
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/localkart?schema=public"

# JWT — MUST be changed in production
JWT_SECRET=change_this_to_a_random_long_secret
JWT_EXPIRES_IN=7d

# CORS — your frontend URL
CORS_ORIGIN=http://localhost:5173
